# Copy this file to .env and fill in real values before running.
# In production (Railway), set these as environment variables in the
# project dashboard instead of using a .env file.

# Railway gives you this automatically when you add a Postgres database.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Generate a real one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me-with-a-long-random-string

# From cloudinary.com dashboard (free tier) - for product photo storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
